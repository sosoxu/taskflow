# Fix #344: TLS 部署形态的前端配置（方案 B —— nginx 前置终止 TLS）。
#
# 用法：作为 /etc/nginx/templates/default.conf.template 挂载进容器，官方
# nginx 镜像的 docker-entrypoint 会做 envsubst 并覆盖 /etc/nginx/conf.d/default.conf。
# 只替换 TLS_/TASKFLOW_ 前缀的变量（compose 里用 NGINX_ENVSUBST_FILTER 限定），
# 因此 nginx 自身的 $host/$uri/$remote_addr 不会被误替换。
#
# 与 nginx.conf 的区别：
# - 8080 只做 301 跳转到 HTTPS，不承载业务；
# - 8443 上终止 TLS（非 root 运行，>1024 端口，见 Fix #331），compose 映射 443:8443；
# - 证书从 /etc/nginx/certs 挂载，文件名由 TLS_CERT_FILE / TLS_KEY_FILE 指定；
# - HSTS 由 TASKFLOW_HSTS_MAX_AGE 控制（0 = 关闭，自签测试时建议设 0）。

log_format taskflow_no_query '$remote_addr - $remote_user [$time_local] '
                             '"$request_method $uri $server_protocol" $status '
                             '$body_bytes_sent "$http_referer" "$http_user_agent"';

server {
    listen 8080;
    server_name _;

    access_log /var/log/nginx/access.log taskflow_no_query;

    # 明文入口只跳转；健康检查类探针也一并跳转（由 LB 直接探 8443）
    return 301 https://$host$request_uri;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    access_log /var/log/nginx/access.log taskflow_no_query;

    ssl_certificate     /etc/nginx/certs/${TLS_CERT_FILE};
    ssl_certificate_key /etc/nginx/certs/${TLS_KEY_FILE};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    # Fix #344: TLS 启用后打开 HSTS。自签证书环境请把 TASKFLOW_HSTS_MAX_AGE 设为 0，
    # 否则浏览器可能把该主机永久锁定到 HTTPS。
    add_header Strict-Transport-Security "max-age=${TASKFLOW_HSTS_MAX_AGE}; includeSubDomains" always;
    # Fix #332: 安全响应头（原样沿用非 TLS 配置）
    server_tokens off;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self' data:" always;

    root /usr/share/nginx/html;
    index index.html;

    # 前端路由 - Vue Router history 模式
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API 代理到 Scheduler（内网明文，见 Fix #344 的 scheduler http_bind_address）
    location /api/ {
        proxy_pass http://scheduler:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # Fix #141: SSE 日志流代理 — 必须禁用缓冲，否则事件会被 nginx 攒在
    # 缓冲区里，实时日志流将失效。
    location ~ /api/v1/instances/.+/tasks/.+/logs/stream$ {
        proxy_pass http://scheduler:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE 关键配置
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        chunked_transfer_encoding on;
    }

    # 静态资源缓存（location 内重新声明安全头，避免被 Cache-Control 覆盖继承）
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        add_header Strict-Transport-Security "max-age=${TASKFLOW_HSTS_MAX_AGE}; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self' data:" always;
    }

    # gzip 压缩
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript;
    gzip_min_length 1000;
}
